{
  "name": "upload-assistant-webui",
  "private": true,
  "version": "1.0.0",
  "description": "Web UI frontend tooling for Upload-Assistant",
  "scripts": {
    "lint:react": "eslint . --ext .js,.jsx --ignore-pattern .eslintrc.js",
    "format:check": "prettier --check ./.eslintrc.js ./*.js ./package*.json ../../templates/*.html ../../../docs/**/*.md ../../../README.md",
    "format": "prettier --write ./.eslintrc.js ./*.js ./package*.json ../../templates/*.html ../../../docs/**/*.md ../../../README.md"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/eslint-parser": "^7.22.5",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.6.2"
  }
}
