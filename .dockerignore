# Version control
.git
.gitignore
.github

# Python bytecode & caches
**/__pycache__
**/*.pyc
**/*.pyo
*.egg-info
.mypy_cache
.ruff_cache

# Virtual environments (host-side; the image builds its own at /venv)
venv
.venv

# IDE / editor
.vscode
.cursor
.idea
*.swp
*.swo

# Docker files (not needed inside the image)
docker-compose.yml
Dockerfile
.dockerignore

# Documentation (not needed at runtime)
docs

# Local configuration, credentials and runtime state (never bake into the image)
data/config*.py
data/cookies
data/cache
data/nfos
data/tvdb
data/banned
data/web_ui

# Runtime artifacts that should not leak into the build context
tmp
*.torrent
*.log

# Local build and test output
build
dist
.setuptools-build
.pytest_cache
*.lnk

# OS junk
Thumbs.db
.DS_Store

# Tests / CI
tests
bandit.yaml
